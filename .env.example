# --- LLM provider ---
# Only fill in the one(s) you're using.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Which provider/model to use for triage classification + drafting
LLM_PROVIDER=anthropic          # "anthropic" or "openai"
LLM_MODEL=claude-sonnet-5          # cheaper option for triage: claude-haiku-4-5-20251001

# --- Gmail API (OAuth) ---
# Created via Google Cloud Console > APIs & Services > Credentials
# Download the OAuth client as credentials.json into project root (gitignored).
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json

# --- Guardrails ---
# Hard cap on LLM calls this process will make per hour. Trips a circuit
# breaker when exceeded, rather than silently burning spend.
MAX_LLM_CALLS_PER_HOUR=100

# Hard cap on emails the agent will process in a single run.
MAX_EMAILS_PER_RUN=25

# If true, the agent NEVER sends email on its own — it only creates Gmail
# drafts, which a human must review and send manually. This is the safe
# default and should stay true until you've reviewed the audit logs.
REQUIRE_HUMAN_APPROVAL=true

# Where audit logs (every agent action, timestamped) are written.
AUDIT_LOG_DIR=audit_logs
